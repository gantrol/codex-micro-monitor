<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings owns these resources; the keypad retains its material palette. -->
    <SolidColorBrush x:Key="SettingsSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SettingsInk" Color="#1A1C1D" />
    <SolidColorBrush x:Key="SettingsMuted" Color="#5F6866" />
    <SolidColorBrush x:Key="SettingsLine" Color="#E0E3E3" />
    <SolidColorBrush x:Key="SettingsStrongLine" Color="#9AA1A0" />
    <SolidColorBrush x:Key="SettingsHover" Color="#F4F5F5" />
    <SolidColorBrush x:Key="SettingsAccent" Color="#53675A" />
    <SolidColorBrush x:Key="SettingsSelected" Color="#E6EBE6" />
    <SolidColorBrush x:Key="SettingsSelectedInk" Color="#405247" />
    <SolidColorBrush x:Key="SettingsOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SettingsSuccess" Color="#2F7D46" />
    <SolidColorBrush x:Key="SettingsDanger" Color="#BE4238" />
    <FontFamily x:Key="SettingsFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>

    <Style x:Key="SettingsFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource SettingsAccent}"
                            BorderThickness="2" CornerRadius="5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SettingsFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
    </Style>
    <Style x:Key="OptionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SettingsRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SettingsInk}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource SettingsSelectedInk}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsLine}" />
    </Style>

    <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource SettingsSelectedInk}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource SettingsOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsCombo" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="205" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,7,30,7" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsInk}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItem}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <Path Width="8" Height="4" Margin="0,0,11,0" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsHitTestVisible="False" Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,3,0,0" Padding="4" Background="{DynamicResource SettingsSurface}"
                                    BorderBrush="{DynamicResource SettingsStrongLine}" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SettingsSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource SettingsSelectedInk}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SwitchToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource SettingsMuted}"
                                Background="{DynamicResource SettingsSurface}">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0"
                                     HorizontalAlignment="Left" Fill="{DynamicResource SettingsMuted}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsInk}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsAccent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SettingsOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsHover}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsMuted}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SettingsMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PreviewSlotButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsStrongLine}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outline" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource SettingsAccent}" />
                            <Setter TargetName="Outline" Property="BorderThickness" Value="6" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource SettingsAccent}" />
                            <Setter TargetName="Outline" Property="BorderThickness" Value="8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource SettingsSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="3" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="1" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource SettingsAccent}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="28" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="Knob" Width="14" Height="14"
                                                         Fill="{DynamicResource SettingsSurface}"
                                                         Stroke="{DynamicResource SettingsAccent}" StrokeThickness="2" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SettingsSelected}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SettingsAccent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource SettingsStrongLine}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
