<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CodexMicro.Desktop.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="MicroPopupPalette.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="MicroHelpFace" Color="#FCFDFC" />
        <SolidColorBrush x:Key="MicroHelpRim" Color="#F3F7F5" />
        <SolidColorBrush x:Key="MicroHelpTrack" Color="#DEE7E1" />
        <!-- The custom entrance replaces the native popup animation. -->
        <PopupAnimation x:Key="{x:Static SystemParameters.ToolTipPopupAnimationKey}">None</PopupAnimation>

        <Style x:Key="MicroHelpBody" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#626B70" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MicroHelpDetail" TargetType="TextBlock" BasedOn="{StaticResource MicroHelpBody}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="MicroHelpTitle" TargetType="TextBlock" BasedOn="{StaticResource MicroHelpBody}">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MicroHelpSection" TargetType="TextBlock" BasedOn="{StaticResource MicroHelpTitle}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MicroHelpCaption" TargetType="TextBlock" BasedOn="{StaticResource MicroHelpBody}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style x:Key="MicroHelpMetric" TargetType="TextBlock" BasedOn="{StaticResource MicroHelpTitle}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="LineHeight" Value="32" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="MicroHelpDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,12" />
            <Setter Property="Background" Value="{StaticResource MicroPopupLine}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MicroHelpProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MicroPopupAccent}" />
            <Setter Property="Background" Value="{StaticResource MicroHelpTrack}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{StaticResource MicroHelpFace}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MicroPopupEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MaxWidth" Value="380" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Placement" Value="MousePoint" />
            <Setter Property="HorizontalOffset" Value="4" />
            <Setter Property="VerticalOffset" Value="2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="controls:MicroToolTipMotion.IsEnabled"
                    Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Grid x:Name="CrystalRoot" Margin="10,8,10,16">
                            <Grid x:Name="CrystalSurface" RenderTransformOrigin="0.5,0">
                                <Border x:Name="CrystalShadow" Margin="1,2,1,0"
                                        Background="{StaticResource MicroHelpRim}" CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#3A5049" BlurRadius="14"
                                                          ShadowDepth="3" Opacity="0.14" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="CrystalRim" Background="{StaticResource MicroHelpRim}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" />
                                <Border Margin="5,4,5,6" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" />
                                <Border x:Name="CrystalHighlight" Height="1" Margin="12,1,12,0"
                                        VerticalAlignment="Top" Background="#F2FFFFFF" />
                                <Border x:Name="CrystalRefraction" Height="2" Margin="14,0,14,2"
                                        VerticalAlignment="Bottom" Background="#50B9CCC2" CornerRadius="1" />
                            </Grid>
                            <Border x:Name="CrystalContent" Margin="5,4,5,6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                <Setter TargetName="CrystalShadow" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CrystalHighlight" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CrystalRefraction" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CrystalRim" Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

</ResourceDictionary>
