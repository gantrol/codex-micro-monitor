<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System"/><Using Include="System.Collections.Generic"/><Using Include="System.Linq"/>
    <Using Include="System.Threading"/><Using Include="System.Threading.Tasks"/>
    <ProjectReference Include="../CodexMicro.Core/CodexMicro.Core.csproj" />
    <PackageReference Include="Tomlyn" />
    <InternalsVisibleTo Include="CodexMicro" />
    <InternalsVisibleTo Include="CodexMicro.Plugin" />
    <InternalsVisibleTo Include="CodexMicro.Desktop.Tests" />
    <InternalsVisibleTo Include="CodexMicro.StoreAssets" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows10.0.19041.0</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalCodexControl)' != 'true'">
    <PackageReference Include="CodexControl" />
    <PackageReference Include="CodexControl.Windows" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalCodexControl)' == 'true'">
    <ProjectReference Include="../../../codex-control/src/CodexControl/CodexControl.csproj" />
    <ProjectReference Include="../../../codex-control/src/CodexControl.Windows/CodexControl.Windows.csproj" />
  </ItemGroup>
</Project>
